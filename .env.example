# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=ThinkSync
APP_VERSION=2.0.0
DEBUG=false

# ── Backend server ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NEVER expose to client

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","https://app.thinksync.art"]

# ── SSH ───────────────────────────────────────────────────────────────────────
SSH_TIMEOUT=30
SSH_COMMAND_TIMEOUT=60

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Agent (Forge v2) ──────────────────────────────────────────────────────────
# Max LLM-driven retries per step (default 3)
AGENT_MAX_RETRIES=3
# Comma-separated tool names that require allow_write=true
AGENT_V2_WRITE_TOOLS=restart_service,deploy_app
# Upstash Redis URL for LLM response caching (optional)
# REDIS_URL=rediss://:<password>@<host>:<port>
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
